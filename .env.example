# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# Cryptographic Keys (Required - never commit actual keys to version control)
# FPE_KEY must be a 32-character hex string (16 bytes)
FPE_KEY=0123456789abcdef0123456789abcdef
# VAULT_MASTER_KEY must be a 64-character hex string (32 bytes AES-256)
VAULT_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# HMAC salt for deterministic tokenization
HMAC_SALT=0123456789abcdef0123456789abcdef
# JWT Secret for authentication tokens
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database URIs (Separate logical/physical databases)
SOURCE_DB_URL=sqlite:///./backend/data/source.db
PROTECTED_DB_URL=sqlite:///./backend/data/protected.db
VAULT_DB_URL=sqlite:///./backend/data/vault.db
POLICY_DB_URL=sqlite:///./backend/data/policy.db
AUDIT_DB_URL=sqlite:///./backend/data/audit.db
BATCH_DB_URL=sqlite:///./backend/data/batch.db

# Email / Mailpit Configuration
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAILBOX_ENABLED=True
